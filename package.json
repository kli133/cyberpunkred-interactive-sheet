{
  "name": "cyberpunk-red-character-sheet",
  "version": "1.0.0",
  "description": "Автономный интерактивный лист персонажа Cyberpunk RED",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.cyberpunkred.character-sheet",
    "productName": "Cyberpunk RED Character Sheet",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "electron-main.cjs",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "Cyberpunk-RED-Character-Sheet-${version}.exe"
    }
  }
}
